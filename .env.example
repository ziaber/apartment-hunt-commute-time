# Google Maps API Configuration
# Get your API key from: https://console.cloud.google.com/google/maps-apis/
GOOGLE_MAPS_API_KEY=your_api_key_here

# Job Locations
# Your job location (address or POI in Kraków)
MY_JOB_LOCATION=Rynek Główny, Kraków

# Your girlfriend's job location (address or POI in Kraków)
GIRLFRIEND_JOB_LOCATION=AGH University of Science and Technology, Kraków

# Travel Modes
# Options: 'driving', 'transit', 'walking', 'bicycling'
MY_TRAVEL_MODE=transit
GIRLFRIEND_TRAVEL_MODE=driving

# Commute Time Calculation Settings
# Arrival time range (in 24-hour format)
START_HOUR=7
END_HOUR=18

# Interval between calculations (in minutes)
INTERVAL_MINUTES=30

# Database Path (optional)
DB_PATH=commute_cache.db
